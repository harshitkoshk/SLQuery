{
  "name": "smart-streetlight-monitoring",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Streetlight Monitoring & AI Verification System (Fullstack)",
  "main": "src/server.js",
  "scripts": {
    "dev": "vite",
    "server": "node src/server.js",
    "dev:server": "node --watch src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/server.js",
    "render:build": "prisma generate && vite build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "vite": "^6.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
